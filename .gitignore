tools/_*.png
tools/_*.jpg
tools/_*.txt
tools/_*.tar.gz
tools/_*.zip
# One-off debug scripts (FEAT/_sN/_rN/_ux/_f1x/_fix/_mk/_hook/_demo...).
# NOTE: reusable tooling does NOT use the underscore prefix and stays tracked --
#       verify-business-backend.js, reconcile-kc-xboard.js, check-docs-sync.js,
#       xboard-apply-custom-html.js, xboard-restore-custom-html.js,
#       xboard-set-custom-html.php, xboard-kc-*.php, xboard-patch-*.php,
#       test-integration-*.js, kc_*_inject.html
tools/_*.js
tools/_*.php
tools/_reg_result.txt
tools/_ux_notes.txt
tools/_fix1_out.txt
# Reference source copies pulled out of the Xboard container for diffing.
# The authoritative versions live in tools/xboard-patches/.
tools/_rc/
tools/_xb_src/

