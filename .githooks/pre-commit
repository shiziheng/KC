#!/usr/bin/env node
/**
 * .githooks/pre-commit —— 提交前强制校验文档与代码同步
 *
 * 启用（一次性）：
 *   git config core.hooksPath .githooks
 *
 * 说明：文档滞后是"看不见"的腐化 —— 没有报错、没有异常，
 * 只有接手的人默默按过期信息干活。因此做成硬拦截而不是写在规范里靠自觉。
 */
'use strict';

const { execFileSync } = require('child_process');
const path = require('path');

const script = path.resolve(__dirname, '..', 'tools', 'check-docs-sync.js');

let output = '';
let code = 0;
try {
  output = execFileSync(process.execPath, [script], { encoding: 'utf8' });
} catch (e) {
  output = (e.stdout || '') + (e.stderr || '');
  code = e.status === undefined ? 1 : e.status;
}

process.stdout.write(output);

if (code !== 0) {
  console.error('\n提交被拦截：文档与代码未同步。');
  console.error('请按 docs/开发规范.md 第 2 节六步流程补全后重新提交。');
  console.error('补全顺序：产品全景.md（含顶部「对应版本」）→ CHANGELOG.md → README.md / VERSION.json / 00_项目状态.md');
  console.error('紧急情况可临时跳过：git commit --no-verify（请勿常态化使用）');
  process.exit(code);
}

// ── 2026-10-11：货币显示守护（全站金额一律以美元($)展示，不允许人民币符号/字样出现在显示面）──
const curScript = path.resolve(__dirname, '..', 'tools', 'check-currency.js');
let curOut = '';
let curCode = 0;
try {
  curOut = execFileSync(process.execPath, [curScript], { encoding: 'utf8' });
} catch (e) {
  curOut = (e.stdout || '') + (e.stderr || '');
  curCode = e.status === undefined ? 1 : e.status;
}
process.stdout.write(curOut);
if (curCode !== 0) {
  console.error('\n提交被拦截：显示面出现人民币符号/字样。');
  console.error('全站金额与余额一律以美元($)展示（用户要求 · 2026-10-11）。');
  console.error('如属「货币兜底替换实现」白名单，请更新 tools/check-currency.js 的 ALLOW_LINE。');
  process.exit(curCode);
}